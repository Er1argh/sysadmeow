<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true" tools:theme="@style/Theme.SysAdMeow">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="22dp" android:paddingBottom="34dp">
  <Button android:id="@+id/btnBack" android:layout_width="110dp" android:layout_height="44dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="← Назад" android:textAllCaps="false" android:textColor="@color/primary"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Создаём кото-аккаунт" android:textColor="@color/text_main" android:textSize="28sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Выберите роль сейчас: её нельзя менять из приложения после регистрации." android:textColor="@color/text_muted" android:textSize="14sp"/>
  <ImageView android:id="@+id/ivAvatar" android:layout_width="90dp" android:layout_height="90dp" android:layout_gravity="center_horizontal" android:layout_marginTop="20dp" android:contentDescription="Случайная аватарка кота" tools:src="@drawable/avatar_cat_blue"/>
  <Button android:id="@+id/btnAvatar" android:layout_width="220dp" android:layout_height="46dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="Другой случайный кот" android:textAllCaps="false" android:textColor="@color/primary"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Имя" android:textStyle="bold"/>
  <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="Как вас показывать в приложении" android:paddingHorizontal="16dp" android:singleLine="true"/>
  <TextView android:id="@+id/tvNameError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Email" android:textStyle="bold"/>
  <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="cat@example.com" android:inputType="textEmailAddress" android:paddingHorizontal="16dp" android:singleLine="true"/>
  <TextView android:id="@+id/tvEmailError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Пароль" android:textStyle="bold"/>
  <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="Минимум 6 символов" android:inputType="textPassword" android:paddingHorizontal="16dp" android:singleLine="true"/>
  <TextView android:id="@+id/tvPasswordError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Кто вы в SysAdMeow?" android:textColor="@color/text_main" android:textStyle="bold"/>
  <RadioGroup android:id="@+id/rgRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
   <RadioButton android:id="@+id/rbClient" android:layout_width="match_parent" android:layout_height="48dp" android:checked="true" android:text="Ищу сетевого специалиста"/>
   <RadioButton android:id="@+id/rbAdmin" android:layout_width="match_parent" android:layout_height="48dp" android:text="Я sysadmin-кот и хочу публиковать услуги"/>
  </RadioGroup>
  <TextView android:id="@+id/tvRoleHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_warning" android:padding="12dp" android:text="Вы сможете искать специалистов, оплачивать услуги и оставлять отзывы." android:textColor="@color/warning" android:textSize="13sp"/>
  <TextView android:id="@+id/tvFormError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_failure" android:padding="12dp" android:textColor="@color/danger" android:visibility="gone"/>
  <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone"/>
  <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:text="Зарегистрироваться" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp"/>
 </LinearLayout>
</ScrollView>
