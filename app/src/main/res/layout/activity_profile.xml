<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:focusable="true" android:focusableInTouchMode="true" tools:theme="@style/Theme.SysAdMeow">
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="112dp" android:focusableInTouchMode="true">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Мой профиль" android:textColor="@color/text_main" android:textSize="28sp" android:textStyle="bold"/>
   <ImageView android:id="@+id/ivAvatar" android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:contentDescription="Аватар пользователя" tools:src="@drawable/avatar_cat_green"/>
   <TextView android:id="@+id/tvEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_muted" tools:text="cat@example.com"/>
   <TextView android:id="@+id/tvRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="@color/primary" android:textStyle="bold" tools:text="Роль: sysadmin-кот"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Отображаемое имя" android:textStyle="bold"/>
   <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:paddingHorizontal="16dp" android:singleLine="true" android:selectAllOnFocus="false"/>
   <TextView android:id="@+id/tvNameError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone"/>
   <Button android:id="@+id/btnSaveName" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="Сохранить имя" android:textAllCaps="false" android:textColor="@color/primary"/>
   <TextView android:id="@+id/tvClientHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_warning" android:padding="14dp" android:text="Вы зарегистрированы как заказчик. Выбирайте sysadmin-котов в каталоге, оплачивайте услуги и оставляйте отзывы в их карточках." android:textColor="@color/warning" android:visibility="gone"/>
   <LinearLayout android:id="@+id/adminSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" android:visibility="gone" tools:visibility="visible">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Моя публичная карточка" android:textColor="@color/text_main" android:textSize="21sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvPublicationState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_warning" android:padding="12dp" android:text="Сейчас это черновик" android:textColor="@color/warning"/>
    <EditText android:id="@+id/etTitle" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:hint="Название услуги, например VPN / MikroTik" android:paddingHorizontal="16dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Категории (можно несколько)" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
     <CheckBox android:id="@+id/cbVpn" android:layout_width="match_parent" android:layout_height="42dp" android:text="VPN"/><CheckBox android:id="@+id/cbMikrotik" android:layout_width="match_parent" android:layout_height="42dp" android:text="MikroTik"/><CheckBox android:id="@+id/cbCisco" android:layout_width="match_parent" android:layout_height="42dp" android:text="Cisco"/><CheckBox android:id="@+id/cbLinux" android:layout_width="match_parent" android:layout_height="42dp" android:text="Linux"/><CheckBox android:id="@+id/cbSecurity" android:layout_width="match_parent" android:layout_height="42dp" android:text="Security"/>
    </LinearLayout>
    <EditText android:id="@+id/etExperience" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Опыт, лет (0–60)" android:inputType="number" android:paddingHorizontal="16dp"/>
    <EditText android:id="@+id/etPrice" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Цена разовой услуги, BYN" android:inputType="number" android:paddingHorizontal="16dp"/>
    <EditText android:id="@+id/etBio" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:gravity="top|start" android:hint="Опишите, что именно вы настраиваете и кому помогаете" android:inputType="textCapSentences|textMultiLine" android:padding="14dp"/>
    <TextView android:id="@+id/tvListingError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone"/>
    <Button android:id="@+id/btnSaveDraft" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="Сохранить черновик" android:textAllCaps="false" android:textColor="@color/primary"/>
    <Button android:id="@+id/btnPublish" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:text="Опубликовать / обновить карточку" android:textAllCaps="false" android:textColor="@color/white"/>
   </LinearLayout>
   <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="28dp" android:background="@drawable/bg_failure" android:backgroundTint="@null" android:text="Выйти из аккаунта" android:textAllCaps="false" android:textColor="@color/danger"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="После выхода для возврата потребуется email и пароль." android:textColor="@color/text_muted" android:textSize="12sp"/>
  </LinearLayout>
 </ScrollView>
 <include android:id="@+id/bottomNav" layout="@layout/layout_bottom_nav" android:layout_width="wrap_content" android:layout_height="72dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="14dp"/>
</FrameLayout>
