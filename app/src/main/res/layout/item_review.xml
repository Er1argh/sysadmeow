<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:contentPadding="14dp" tools:theme="@style/Theme.SysAdMeow">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
   <ImageView android:id="@+id/ivAvatar" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="Аватар автора" tools:src="@drawable/avatar_cat_pink"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/tvAuthor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_main" android:textStyle="bold" tools:text="Мурка"/>
    <TextView android:id="@+id/tvDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="11sp" tools:text="04.10.2026"/>
   </LinearLayout>
   <TextView android:id="@+id/tvRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/warning" android:textStyle="bold" tools:text="★★★★★"/>
  </LinearLayout>
  <TextView android:id="@+id/tvText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="2dp" android:textColor="@color/text_muted" tools:text="Очень аккуратно настроил маршрутизацию."/>
 </LinearLayout>
</androidx.cardview.widget.CardView>
