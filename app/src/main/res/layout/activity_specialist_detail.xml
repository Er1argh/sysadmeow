<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" tools:theme="@style/Theme.SysAdMeow">
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:paddingBottom="86dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="18dp" android:paddingBottom="110dp">
   <Button android:id="@+id/btnBack" android:layout_width="110dp" android:layout_height="44dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="← Назад" android:textAllCaps="false" android:textColor="@color/primary"/>
   <ImageView android:id="@+id/ivAvatar" android:layout_width="110dp" android:layout_height="110dp" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:contentDescription="Аватар sysadmin-кота" tools:src="@drawable/avatar_cat_gray"/>
   <TextView android:id="@+id/tvName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_main" android:textSize="26sp" android:textStyle="bold" tools:text="Марсель Пакетов"/>
   <TextView android:id="@+id/tvRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:textColor="@color/primary" android:textSize="16sp" tools:text="Cisco / Routing specialist"/>
   <TextView android:id="@+id/tvMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/text_muted" tools:text="8 лет опыта · ★ 4.8 (12)"/>
   <TextView android:id="@+id/tvStack" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_secondary" android:padding="12dp" android:textColor="@color/primary" android:textStyle="bold" tools:text="Cisco • VPN • Security"/>
   <TextView android:id="@+id/tvBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_muted" tools:text="Настраиваю офисные сети и удалённый доступ."/>
   <TextView android:id="@+id/tvPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:padding="16dp" android:textColor="@color/text_main" android:textSize="18sp" android:textStyle="bold" tools:text="4500 BYN за разовую настройку"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Ваш отзыв" android:textColor="@color/text_main" android:textSize="20sp" android:textStyle="bold"/>
   <TextView android:id="@+id/tvReviewHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_warning" android:padding="12dp" android:text="Проверяем возможность оставить отзыв…" android:textColor="@color/warning" android:textSize="13sp"/>
   <LinearLayout android:id="@+id/reviewForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone" tools:visibility="visible">
    <RatingBar android:id="@+id/ratingBar" style="?android:attr/ratingBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:numStars="5" android:rating="0" android:stepSize="1"/>
    <EditText android:id="@+id/etReview" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:gravity="top|start" android:hint="Что понравилось? Как прошла настройка?" android:inputType="textCapSentences|textMultiLine" android:maxLength="500" android:padding="14dp"/>
    <TextView android:id="@+id/tvReviewValidation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone"/>
    <Button android:id="@+id/btnReview" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="Опубликовать отзыв" android:textAllCaps="false" android:textColor="@color/primary"/>
   </LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Отзывы" android:textColor="@color/text_main" android:textSize="20sp" android:textStyle="bold"/>
   <TextView android:id="@+id/tvNoReviews" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Отзывов пока нет" android:textColor="@color/text_muted" android:visibility="gone"/>
   <ProgressBar android:id="@+id/reviewProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:visibility="gone"/>
   <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvReviews" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" tools:itemCount="2" tools:listitem="@layout/item_review"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
    <Button android:id="@+id/btnPrev" android:layout_width="110dp" android:layout_height="44dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="Назад" android:textAllCaps="false" android:textColor="@color/primary"/>
    <TextView android:id="@+id/tvPage" android:layout_width="100dp" android:layout_height="match_parent" android:gravity="center" android:text="Страница 1" android:textColor="@color/text_muted"/>
    <Button android:id="@+id/btnNext" android:layout_width="110dp" android:layout_height="44dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="Далее" android:textAllCaps="false" android:textColor="@color/primary"/>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <Button android:id="@+id/btnAdd" android:layout_width="match_parent" android:layout_height="58dp" android:layout_gravity="bottom" android:layout_marginHorizontal="20dp" android:layout_marginBottom="18dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:elevation="8dp" android:text="Добавить услугу в корзину" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp"/>
</FrameLayout>
