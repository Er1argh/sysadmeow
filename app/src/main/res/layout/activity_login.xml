<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true" tools:theme="@style/Theme.SysAdMeow">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="28dp" android:paddingVertical="24dp">
  <ImageView android:layout_width="92dp" android:layout_height="92dp" android:layout_gravity="center_horizontal" android:src="@drawable/avatar_cat_ginger" android:contentDescription="Логотип кота"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="SysAdMeow" android:textColor="@color/text_main" android:textSize="34sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Удалённая настройка сетей — теперь с котами" android:textColor="@color/text_muted" android:textSize="15sp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Email" android:textStyle="bold" android:textColor="@color/text_main"/>
  <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:hint="cat@example.com" android:inputType="textEmailAddress" android:paddingHorizontal="16dp" android:singleLine="true"/>
  <TextView android:id="@+id/tvEmailError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone" tools:text="Проверьте формат email" tools:visibility="visible"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Пароль" android:textStyle="bold" android:textColor="@color/text_main"/>
  <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:hint="Минимум 6 символов" android:inputType="textPassword" android:paddingHorizontal="16dp" android:singleLine="true"/>
  <TextView android:id="@+id/tvPasswordError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone"/>
  <TextView android:id="@+id/tvFormError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_failure" android:padding="12dp" android:textColor="@color/danger" android:visibility="gone"/>
  <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone"/>
  <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:text="Войти" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp"/>
  <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="Создать аккаунт" android:textAllCaps="false" android:textColor="@color/primary"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="После входа сессия сохранится. Повторно вводить пароль нужно только после кнопки «Выйти»." android:textColor="@color/text_muted" android:textSize="12sp"/>
 </LinearLayout>
</ScrollView>
