<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical" android:padding="24dp" tools:theme="@style/Theme.SysAdMeow">
 <ImageView android:layout_width="78dp" android:layout_height="78dp" android:layout_gravity="center_horizontal" android:src="@drawable/avatar_cat_blue" android:contentDescription="Кот оплаты"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Безопасная оплата" android:textColor="@color/text_main" android:textSize="27sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Данные карты вводятся на экране beGateway SDK" android:textColor="@color/text_muted"/>
 <TextView android:id="@+id/tvAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_card" android:gravity="center" android:padding="18dp" android:text="Сумма: 0 BYN" android:textColor="@color/text_main" android:textSize="21sp" android:textStyle="bold"/>
 <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:visibility="gone"/>
 <LinearLayout android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_success" android:orientation="vertical" android:padding="16dp" android:visibility="gone"><TextView android:id="@+id/tvResultTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_main" android:textSize="20sp" android:textStyle="bold"/><TextView android:id="@+id/tvResultStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_muted"/><TextView android:id="@+id/tvResultHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_muted"/></LinearLayout>
 <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
 <Button android:id="@+id/btnPay" android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:text="Открыть форму карты" android:textAllCaps="false" android:textColor="@color/white"/>
 <Button android:id="@+id/btnClose" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="Закрыть" android:textAllCaps="false" android:textColor="@color/primary"/>
</LinearLayout>
