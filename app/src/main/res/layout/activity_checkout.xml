<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical" android:padding="24dp" tools:theme="@style/Theme.SysAdMeow">
 <Button android:id="@+id/btnBack" android:layout_width="110dp" android:layout_height="44dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:text="← Назад" android:textAllCaps="false" android:textColor="@color/primary"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Оформление заказа" android:textColor="@color/text_main" android:textSize="28sp" android:textStyle="bold"/>
 <TextView android:id="@+id/tvSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:padding="18dp" android:text="К оплате: 0 BYN" android:textColor="@color/text_main" android:textSize="21sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="После оплаты заказ сохраняется в Firestore, корзина очищается, а приложение показывает итоговый статус." android:textColor="@color/text_muted" android:lineSpacingExtra="3dp"/>
 <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:visibility="gone"/>
 <LinearLayout android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_success" android:orientation="vertical" android:padding="16dp" android:visibility="gone"><TextView android:text="Готово" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold"/></LinearLayout>
 <TextView android:id="@+id/tvAfterPayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_muted" android:visibility="gone"/>
 <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
 <Button android:id="@+id/btnPay" android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:text="Перейти к оплате" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp"/>
 <Button android:id="@+id/btnDone" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_accent" android:backgroundTint="@null" android:text="Вернуться в каталог" android:textAllCaps="false" android:textColor="@color/white" android:visibility="gone"/>
</LinearLayout>
