rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUid(uid) { return signedIn() && request.auth.uid == uid; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdminCat() { return signedIn() && myProfile().data.role == "ADMIN"; }

    match /users/{uid} {
      allow read: if myUid(uid);
      allow create: if myUid(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ["CLIENT", "ADMIN"];
      allow update: if myUid(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && (!resource.data.keys().hasAny(["avatarKey"]) || request.resource.data.avatarKey == resource.data.avatarKey);
      allow delete: if false;
    }

    match /sysadmins/{sysadminId} {
      allow read: if signedIn() && (resource.data.published == true || request.auth.uid == sysadminId);

      allow create: if myUid(sysadminId) && isAdminCat()
        && request.resource.data.ownerUid == sysadminId
        && request.resource.data.rating == 0
        && request.resource.data.ratingSum == 0
        && request.resource.data.reviewsCount == 0;

      // Владелец меняет только описание/цену/категории. Репутацию менять вручную нельзя.
      allow update: if myUid(sysadminId) && isAdminCat()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.ratingSum == resource.data.ratingSum
        && request.resource.data.reviewsCount == resource.data.reviewsCount
        && request.resource.data.latestReviewText == resource.data.latestReviewText
        && request.resource.data.latestReviewerName == resource.data.latestReviewerName;

      // Репутация обновляется только в той же транзакции, где текущий пользователь впервые создаёт свой отзыв.
      allow update: if signedIn() && request.auth.uid != sysadminId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "rating", "ratingSum", "reviewsCount", "latestReviewText", "latestReviewerName"
        ])
        && request.resource.data.reviewsCount == resource.data.reviewsCount + 1
        && request.resource.data.ratingSum >= resource.data.ratingSum + 1
        && request.resource.data.ratingSum <= resource.data.ratingSum + 5
        && request.resource.data.rating == request.resource.data.ratingSum / request.resource.data.reviewsCount
        && !exists(/databases/$(database)/documents/sysadmins/$(sysadminId)/reviews/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/sysadmins/$(sysadminId)/reviews/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/sysadmins/$(sysadminId)/reviews/$(request.auth.uid)).data.rating
             == request.resource.data.ratingSum - resource.data.ratingSum;

      allow delete: if false;

      match /reviews/{reviewerUid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && reviewerUid == request.auth.uid
          && request.auth.uid != sysadminId
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 5
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "PAID"
        && request.resource.data.total > 0;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
